# =========================
# Unity .gitignore (SAFE)
# No scenes or .meta ignored
# =========================

# OS / Editor stuff
.DS_Store
**/.DS_Store
Thumbs.db
.vs/
.gradle/
.utmp/

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Memory / recordings
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE / Solution files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Crash reports
sysinfo.txt
mono_crash.*

# Build artifacts
*.apk
*.aab
*.app
*.unitypackage

# Logs
*.log

# Blender backup files
*.blend1

# Rider / JetBrains
[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# Addressables (generated content only)
ServerData/
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated files
[Aa]ssets/Unity.VisualScripting.Generated/

# =========================
# IMPORTANT:
# - Scenes (*.unity) are tracked
# - Meta files (*.meta) are tracked
# =========================

/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
